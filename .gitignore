# ─── Temporary & Debug Files ─────────────────────────────────────────
*.bat
*.cmd
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.rej

# ─── Environment & Secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
.docker-secrets/

# ─── Docker runtime artifacts (keep Dockerfiles & compose in git) ────
*.log
*.pid
*.pid.lock

# ─── Local volume data (never commit raw data) ───────────────────────
/volumes/
/data/
/db-data/
/models/
/snapshots/

# ─── Dev overrides (local-only compose tweaks) ───────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / Frontend ─────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.next/
.nuxt/
*.tsbuildinfo

# ─── IDE & OS ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── ML / Model artifacts ─────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.engine
runs/
wandb/

# ─── Documentation & Reports ───────────────────────────────────────
*.docx.md
*_Design_Report*
*_Design_Spec*