# ═══════════════════════════════════════════════════════════════
#  Multi-Modal Surveillance Platform — Performance Tuning
#  Placez ce fichier à la racine du projet (même dossier que start_app.bat)
# ═══════════════════════════════════════════════════════════════

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Stream display (MJPEG vers le navigateur) ────────────────────
# Résolution max du flux d'affichage (px, largeur)
# Réduit la bande passante réseau et le CPU d'encodage JPEG
# Valeur suggérée pour réseau local lent : 640
DISPLAY_MAX_W=800

# Qualité JPEG du flux d'affichage (0-100)
# 65 donne un bon compromis qualité/taille (~15% plus léger que 70)
DISPLAY_JPEG_Q=65

# FPS maximum du flux d'affichage publié vers Redis
STREAM_PUBLISH_FPS=25

# ── Inférence AI ─────────────────────────────────────────────────
# Résolution max des frames envoyées à l'AI engine (px, largeur)
AI_MAX_W=640

# Qualité JPEG pour les frames AI
AI_JPEG_Q=65

# Frame-skip pour l'IA : n'envoie qu'1 frame sur N à l'AI engine
# Ex: 3 → l'IA reçoit ~8 fps si la caméra tourne à 25 fps
# Augmenter si le GPU/CPU AI est surchargé (essayer 4 ou 5)
AI_FRAME_SKIP=3

# Profondeur max de la file d'attente Redis pour l'IA
# Si la file dépasse cette valeur, les nouvelles frames sont ignorées (back-pressure)
AI_QUEUE_BACKPRESSURE=4
AI_QUEUE_MAX=2

# ── Capture RTSP/MJPEG ───────────────────────────────────────────
# Taille du ring-buffer par caméra (frames en mémoire)
# 2 = toujours la frame la plus récente, aucun retard
RTSP_QUEUE_SIZE=2

# Taille des chunks de lecture MJPEG (bytes)
# Plus grand = moins d'appels système, meilleur débit sur flux HD
MJPEG_CHUNK=16384

# FPS max pour les fichiers vidéo (lecture en boucle)
VIDEO_FILE_MAX_FPS=60

# ── ONNX Runtime (détection thermique) ──────────────────────────
# Threads intra-op : 2 est optimal sur la plupart des CPU
ONNX_INTRA=2
# Threads inter-op : 1 suffit généralement
ONNX_INTER=1

# ── API / WebSocket (main.py) ────────────────────────────────────
# Intervalle minimum entre deux broadcasts WebSocket de détection
# par caméra (secondes). Évite de saturer les clients JS.
WS_DETECTION_INTERVAL=0.1

# Sleep du générateur MJPEG quand la frame n'a pas changé (secondes)
# 0.02 = cap à 50 fps côté HTTP streaming
MJPEG_IDLE_SLEEP=0.02

# ── CUDA (Windows) ───────────────────────────────────────────────
# Décommentez et adaptez si CUDA n'est pas détecté automatiquement
# CUDA_PATH=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v11.8
