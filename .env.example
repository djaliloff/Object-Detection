# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/surveillance

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# AI Engine Configuration
AI_BACKEND=onnxruntime-gpu
MODEL_PATH=./models

# Camera Configuration
DEFAULT_RTSP_USER=admin
DEFAULT_RTSP_PASS=password

# WebSocket Configuration
WS_HOST=localhost
WS_PORT=8080

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8080

# Logging Configuration
LOG_LEVEL=INFO

# Performance Configuration
MAX_CONCURRENT_CAMERAS=16
FRAME_QUEUE_SIZE=1000
DETECTION_QUEUE_SIZE=1000

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:80
ENABLE_HTTPS=false

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Development Configuration
DEBUG=false
MOCK_CAMERAS=false
